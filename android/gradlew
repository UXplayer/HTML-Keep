#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_BIN="${GRADLE_BIN:-$HOME/.gradle/wrapper/dists/gradle-8.11.1-all/2qik7nd48slq1ooc2496ixf4i/gradle-8.11.1/bin/gradle}"
LOCAL_JAVA_HOME="$ROOT_DIR/../.build/android-toolchain/jdk-17.0.19+10/Contents/Home"
HOMEBREW_JAVA_17_HOME=""

for candidate in \
  /opt/homebrew/opt/openjdk@17 \
  /usr/local/opt/openjdk@17 \
  /opt/homebrew/opt/openjdk \
  /usr/local/opt/openjdk
do
  if [[ -x "$candidate/bin/java" ]]; then
    HOMEBREW_JAVA_17_HOME="$candidate"
    break
  fi
done

if [[ ! -x "$GRADLE_BIN" ]]; then
  echo "Gradle 8.11.1 was not found at $GRADLE_BIN" >&2
  exit 1
fi

if [[ -z "${JAVA_HOME:-}" ]]; then
  if [[ -x "$LOCAL_JAVA_HOME/bin/java" ]]; then
    export JAVA_HOME="$LOCAL_JAVA_HOME"
  elif [[ -n "$HOMEBREW_JAVA_17_HOME" ]]; then
    export JAVA_HOME="$HOMEBREW_JAVA_17_HOME"
  fi
fi

cd "$ROOT_DIR"
exec "$GRADLE_BIN" "$@"
